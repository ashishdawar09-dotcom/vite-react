# Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_ADMIN_EMAIL=your-admin-email

# Sentry configuration (optional)
VITE_SENTRY_DSN=https://your-sentry-dsn

# Web Push configuration (required for push notifications)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Voice assistant (optional) — host of the deployed Cloudflare voice agent,
# e.g. badminton-voice-agent.<subdomain>.workers.dev. The floating mic widget
# stays hidden until this is set.
VITE_VOICE_WORKER_URL=
